# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI
OPENAI_API_KEY=
AI_DEFAULT_MODEL=gpt-5.6-terra
AI_MODEL_SOL=gpt-5.6-sol
AI_MODEL_TERRA=gpt-5.6-terra
AI_MODEL_LUNA=gpt-5.6-luna

# App
APP_BASE_URL=http://localhost:3000

# 공공데이터 API (data.go.kr) — 국토부 실거래가 + 공시지가 공용
DATA_GO_KR_API_KEY=
MOLIT_API_KEY=

# 도로명주소 API (juso.go.kr)
JUSO_CONFIRM_KEY=

# 카카오 지도/로컬 API — https://developers.kakao.com
KAKAO_REST_API_KEY=
NEXT_PUBLIC_KAKAO_APP_KEY=

# 국토교통부 V-World API (지적도 WMS / 연속주제도 2.0) — https://www.vworld.kr
VWORLD_API_KEY=
VWORLD_REFERER=https://cre-dealcard.vercel.app

# ── 모닝 브리핑 실시간화 API 키 ────────────────────────────────────────────
# 빅카인즈 (한국언론진흥재단) — https://www.bigkinds.or.kr 신청
BIGKINDS_ACCESS_KEY=

# 네이버 검색 API — https://developers.naver.com (카페+뉴스 검색)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 소상공인 상권분석 (SEMAS) — data.go.kr 발급 (공공데이터포털 키와 동일 가능)
SEMAS_API_KEY=

# 건물에너지효율등급 API (한국에너지공단) — data.go.kr 발급
ENERGY_API_KEY=

# YouTube Data API v3 — https://console.cloud.google.com
YOUTUBE_API_KEY=

# Vercel Cron 보안 키 (임의 문자열)
CRON_SECRET=your-secret-here

# ── Solapi (카카오 알림톡) ──
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_SENDER_PHONE=
SOLAPI_PFID=

# ══════════════════════════════════════════════════════════════════════════
# ── 주간 CRE 매거진 (docs/magazine/audit-2026-10-04/send-activation-checklist.md, remediation_plan §14) ──
# 실제 값은 Vercel → Settings → Environment Variables 에만 둔다. 이 파일에는 절대 실값을 쓰지 않는다.
# 위 `APP_BASE_URL` / `CRON_SECRET` / `SOLAPI_*` 도 매거진 발송에 필수다(아래 설명 참고).
# ══════════════════════════════════════════════════════════════════════════

# [발송 마스터 스위치] 기본 false. true 가 되어야만 에디터 발송·distribute 가 동작한다. 런타임 조회라 재배포 없이 즉시 차단 가능(비상 스위치).
# 활성화 절차(allowlist → dry-run → 소량 → 전체)는 send-activation-checklist.md 를 따른다.
MAGAZINE_SEND_ENABLED=false

# [드라이런] 기본 true. true 면 sendGate 판정·발송 원장(magazine_dispatch_logs)만 기록하고 Resend/Solapi 를 호출하지 않는다.
# 실발송은 allowlist canary 통과 후에만 false 로 바꾼다.
MAGAZINE_SEND_DRY_RUN=true

# [canary 허용 목록] 쉼표 구분 이메일·전화. 비워 두면 제한 없음(=전체 허용)이므로 실발송 전환 전에 반드시 내부 수신자 3~5개로 설정한다.
MAGAZINE_SEND_ALLOWLIST=

# [주간 생성 cron] 기본 false. true 면 /api/cron/weekly-magazine 이 발행 대기(needs_review) 초안을 생성한다(발송은 하지 않음). C-02(LLM 안전) 이후 활성화.
MAGAZINE_CRON_GENERATE_ENABLED=false

# [자동 발송 허용] 기본 false. 브로커 명시 동의(magazine_settings.auto_send) 기능 구현·승인 후에만 true.
MAGAZINE_AUTO_SEND_ALLOWED=false

# [LLM Mock 허용] 운영은 반드시 false(Mock 응답은 저장·발송 금지). 로컬 개발에서만 true.
MAGAZINE_ALLOW_LLM_MOCK=false

# [독자 행태 수집] 기본 true(수집 고지 후). false 면 뷰어 비콘이 이벤트를 보내지 않는다.
MAGAZINE_TRACKING_ENABLED=true

# [브로커 일일 발송 상한] 선택. 비우면 수신자(구독자×채널) 수가 상한. 숫자를 넣으면 강제 상한.
MAGAZINE_DAILY_CAP=

# [해지 토큰 HMAC 비밀] 필수. 32자 이상 랜덤. 서비스 키 재사용 금지. 없으면 해지 링크를 만들 수 없어 모든 발송이 MISSING_UNSUB_LINK 로 차단된다.
UNSUBSCRIBE_SECRET=

# [구독자 링크 sid 서명 비밀] 필수. 32자 이상 랜덤(UNSUBSCRIBE_SECRET 과 다른 값). 개별 구독자 링크 위·변조 방지.
MAGAZINE_SID_SECRET=

# [절대 URL] 필수(운영 예: https://www.credeal.net). 서버 측 QR·링크·OG·해지 URL 생성에 사용. 위 APP_BASE_URL 이 서버용, 아래가 클라이언트 번들용이며 둘은 같은 값이어야 한다.
# (APP_BASE_URL 은 파일 상단 `# App` 절에 이미 있음 — 중복 정의하지 않는다.)
NEXT_PUBLIC_APP_BASE_URL=http://localhost:3000

# [이메일 발송 — Resend] 없으면 sendGate 가 NO_PROVIDER 로 차단(공유 STUB 은 매거진 경로에서 사용하지 않음).
# EMAIL_FROM 은 Resend 에서 검증(SPF/DKIM/DMARC)된 도메인의 발신 주소와 일치해야 한다. 형식 예) 이름 <magazine@도메인>
RESEND_API_KEY=
EMAIL_FROM=

# [알림톡 — Solapi] 위 SOLAPI_API_KEY / SOLAPI_API_SECRET / SOLAPI_SENDER_PHONE / SOLAPI_PFID 4개가 모두 있어야 알림톡 발송이 가능하다(하나라도 없으면 NO_PROVIDER).
# 카카오 광고성 템플릿 심사 승인 전에는 이 4개를 운영에 넣지 않는다(send-activation-checklist §2).

# [Vercel Cron 인증] 위 CRON_SECRET 은 /api/cron/*, /api/pulse/generate 크론 호출의 Authorization: Bearer 값이다. 운영은 추측 불가능한 값 필수(없으면 401).

# [OG 이미지 한글 폰트 오버라이드] 선택. TTF/OTF 절대경로. 비우면 번들된 public/fonts/NotoSansKR-*, 그다음 ${APP_BASE_URL}/fonts/* 순으로 탐색한다(src/lib/magazine/og-fonts.ts).
MAGAZINE_OG_FONT_PATH=

# [디버그/테스트 전용 — 운영 설정 금지] 로컬 점검용.
#   MAGAZINE_RENDER_DUMP_DIR : 이미지 렌더 시각 점검 테스트가 PNG 를 남길 디렉터리
#   MAGAZINE_SCHEMA_DUMP     : schema-aware mock 이 읽을 OpenAPI 덤프 JSON 경로(없으면 supabase/schema-snapshot.json)
# MAGAZINE_RENDER_DUMP_DIR=
# MAGAZINE_SCHEMA_DUMP=

