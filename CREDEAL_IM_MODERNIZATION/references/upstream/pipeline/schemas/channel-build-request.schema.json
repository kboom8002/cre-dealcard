{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://credeal.example/schemas/im/channel-build-request/1.0.0",
  "title": "IM Channel Build Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["requestId", "caseId", "packageId", "packageHash", "channel", "targetLevel", "disclosureScope", "requestedBy", "requestedAt"],
  "properties": {
    "requestId": {"type": "string", "format": "uuid"},
    "caseId": {"type": "string", "minLength": 1},
    "packageId": {"type": "string", "minLength": 1},
    "packageHash": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "channel": {"enum": ["mobile", "pptx"]},
    "targetLevel": {"enum": ["L0", "L1", "L1.5", "L2", "L3", "L4"]},
    "disclosureScope": {"enum": ["internal", "confidential", "limited_external", "public"]},
    "audienceBrief": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "buyerType": {"type": "string"},
        "purpose": {"type": "string"},
        "emphasis": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "selectedProposalUnitIds": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "selectedPhotoIds": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "requestedBy": {"type": "string", "minLength": 1},
    "requestedAt": {"type": "string", "format": "date-time"}
  }
}

