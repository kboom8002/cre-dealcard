{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://credeal.example/schemas/im/regeneration-plan/1.0.0",
  "title": "IM Regeneration Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["planId", "caseId", "changeEvents", "reuseArtifactIds", "invalidateSubjects", "stagesToRun", "approvalImpacts", "createdAt"],
  "properties": {
    "planId": {"type": "string", "format": "uuid"},
    "caseId": {"type": "string", "minLength": 1},
    "changeEvents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["changeType", "subjectId"],
        "properties": {
          "changeType": {"type": "string"},
          "subjectId": {"type": "string"},
          "beforeHash": {"type": ["string", "null"]},
          "afterHash": {"type": ["string", "null"]}
        }
      }
    },
    "reuseArtifactIds": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "invalidateSubjects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["subjectType", "subjectId", "newFreshnessState", "reasonCode"],
        "properties": {
          "subjectType": {"type": "string"},
          "subjectId": {"type": "string"},
          "newFreshnessState": {"enum": ["stale_review_required", "stale_invalid", "superseded", "revoked"]},
          "reasonCode": {"type": "string"}
        }
      }
    },
    "stagesToRun": {"type": "array", "items": {"type": "string", "pattern": "^[PMS][0-9]{2}$"}},
    "approvalImpacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["approvalType", "action"],
        "properties": {
          "approvalType": {"type": "string"},
          "action": {"enum": ["preserve", "review", "invalidate", "revalidate"]}
        }
      }
    },
    "estimatedDurationSeconds": {"type": "integer", "minimum": 0},
    "estimatedCostClass": {"enum": ["none", "low", "medium", "high"]},
    "requiresUserConfirmation": {"type": "boolean"},
    "createdAt": {"type": "string", "format": "date-time"}
  }
}

