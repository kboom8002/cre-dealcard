{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://credeal.example/schemas/integrated-work-item.schema.json",
  "title":"CREDEAL Integrated Modernization Work Item",
  "type":"object",
  "additionalProperties":false,
  "required":["id","phase","title","requirements","owner","acceptance_tests","evidence","feature_flag","rollback"],
  "properties":{
    "id":{"type":"string","pattern":"^CIM-[0-9]{4}$"},
    "phase":{"type":"string","pattern":"^CIM-M[0-8]$"},
    "title":{"type":"string","minLength":3},
    "requirements":{"type":"array","minItems":1,"items":{"type":"string","pattern":"^CIM-R-[0-9]{3}$"}},
    "depends_on":{"type":"array","items":{"type":"string","pattern":"^CIM-[0-9]{4}$"},"default":[]},
    "owner":{"type":"string","minLength":2},
    "acceptance_tests":{"type":"array","minItems":1,"items":{"type":"string"}},
    "evidence":{"type":"array","minItems":1,"items":{"type":"string"}},
    "feature_flag":{"type":["string","null"]},
    "rollback":{"type":"string","minLength":5},
    "status":{"enum":["BACKLOG","READY","IN_PROGRESS","BLOCKED","VERIFYING","DONE"]}
  }
}
