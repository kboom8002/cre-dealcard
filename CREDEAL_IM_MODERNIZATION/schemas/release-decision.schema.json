{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://credeal.example/schemas/release-decision.schema.json",
  "title":"CREDEAL Release Decision",
  "type":"object",
  "additionalProperties":false,
  "required":["release_id","artifact_types","canary_percent","decision","metrics","blockers","rollback_plan","approvals"],
  "properties":{
    "release_id":{"type":"string"},
    "artifact_types":{"type":"array","minItems":1,"items":{"enum":["DEALCARD","MOBILE_IM","PPTX_IM"]}},
    "canary_percent":{"enum":[0,1,10,50,100]},
    "decision":{"enum":["PROMOTE","HOLD","ROLLBACK"]},
    "metrics":{"type":"object"},
    "blockers":{"type":"array","items":{"type":"string"}},
    "rollback_plan":{"type":"string","minLength":5},
    "approvals":{"type":"array","items":{"type":"object","required":["role","target_hash"],"properties":{"role":{"type":"string"},"target_hash":{"type":"string"}}}}
  }
}
